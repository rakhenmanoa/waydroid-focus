#!/usr/bin/env bash
# SPDX-License-Identifier: 0BSD
#
# waydroid-focus — lance une appli Android dans Waydroid en libérant le GPU et le
# CPU pour elle, puis remet tout comme avant quand elle se ferme.
#
# Pendant que l'appli tourne, côté Waydroid uniquement par défaut :
#   1. avec --freeze seulement : gèle (SIGSTOP) les processus Linux de l'hôte qui
#      utilisent le GPU (Firefox, etc.), sauf le bureau, le terminal et Waydroid ;
#   2. côté Android : coupe les animations système et tue les applis en cache ;
#   3. côté Android : désactive temporairement les applis inutiles que tu as
#      choisies (--disable PAQUET, ou le fichier de config, voir --list) ;
#   4. en option : réduit la résolution (--size) et plafonne la fréquence max du
#      GPU (--gpu-max).
# À la fermeture de l'appli, ou sur Ctrl+C, tout est restauré.
#
# Usage : waydroid-focus [options] <paquet|alias>
#   alias : guitartuna = com.ovelin.guitartuna

set -u

PKG=""
DRY=0
FREEZE=0 # gel des processus Linux de l'hôte : sur demande seulement (--freeze)
ANDROID=1
GPUMAX=""
SIZE=""
STOP=0
KEEP_EXTRA=()
DISABLE=()
NODISABLE=0
BG=0
BGSYS=0
KEEPAPP=()
MODE=run # run | list | listbg | restore
ROOT="${WF_ROOT:-}" # préfixe de /proc et /sys, pour les tests uniquement

# Applis Android à désactiver : fichier de config (un paquet par ligne, # = commentaire)
CONF_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/waydroid-focus/disable.list"
# Paquets désactivés par nous : permet de tout réactiver même après un plantage
STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/waydroid-focus/disabled.list"
# Paquets qu'on refuse de désactiver, quoi qu'on demande : désactiver l'un d'eux
# casse la session Waydroid, la saisie ou l'affichage. La liste s'ajoute à celle
# calculée au vol (clavier et lanceur réellement en service, voir dynamic_protect).
PROTECT_RE='waydro'                                 # tout ce qui touche à Waydroid
PROTECT_RE+='|^android$'                            # le framework lui-même
PROTECT_RE+='|^com\.android\.systemui'              # barre d'état, navigation
PROTECT_RE+='|^com\.android\.shell$'                # c'est par là qu'on passe
PROTECT_RE+='|^com\.android\.providers\.'           # réglages, médias, téléchargements
PROTECT_RE+='|^com\.android\.permissioncontroller$' # permissions
PROTECT_RE+='|^com\.android\.packageinstaller$|^com\.google\.android\.packageinstaller$'
PROTECT_RE+='|^com\.android\.externalstorage$|^com\.android\.documentsui$'
PROTECT_RE+='|^com\.android\.keychain$|^com\.android\.se$'
PROTECT_RE+='|^com\.android\.networkstack|^com\.android\.captiveportallogin$'
PROTECT_RE+='|webview|^com\.android\.htmlviewer$'   # moteur web partagé
PROTECT_RE+='|inputmethod|keyboard|\.ime$'          # claviers
PROTECT_RE+='|^com\.android\.launcher|trebuchet'    # écran d'accueil
PROTECT_RE+='|^com\.google\.android\.gms$|^com\.google\.android\.gsf$'
PROTECT_RE+='|setupwizard|^org\.lineageos\.lineageparts$'

# Processus jamais gelés (nom de commande, regex étendue).
KEEP_RE='^(kwin|plasma|startplasma|Xwayland|waydroid|lxc|sddm|systemd|pipewire|wireplumber|dbus|kded|ksmserver|kscreen|powerdevil|kglobalaccel|maliit|squeekboard|xdg-|polkit|bash$|sh$|zsh$|fish$|sudo$)'

usage() {
  cat <<'EOF'
Usage : waydroid-focus [options] <paquet|alias>

  alias : guitartuna = com.ovelin.guitartuna

Options :
  -n, --dry-run      affiche ce qui serait fait, sans rien modifier
  --freeze           gèle aussi (SIGSTOP) les processus Linux de l'hôte qui utilisent
                     le GPU ; sans cette option, seul le côté Waydroid est touché
  --no-freeze        (par défaut) ne touche pas aux processus de l'hôte
  --no-android       ne touche pas aux réglages Android (animations, applis en cache)
  --gpu-max MHZ      plafonne la fréquence max du GPU pendant l'appli (ex. 500)
  --size LxH         change la résolution Android pendant l'appli (ex. 720x1560)
  --keep REGEX       nom de processus supplémentaire à ne jamais geler (répétable)
  --disable PAQUET   désactive cette appli Android pendant l'appli (répétable)
  --bg               désactive automatiquement toutes les applis Android tierces
                     (sauf l'appli lancée et les paquets protégés)
  --bg-system        comme --bg, mais inclut aussi les applis système non essentielles
                     (à essayer d'abord avec -n ; voir l'avertissement du README)
  --keep-app PAQUET  appli à ne pas désactiver avec --bg/--bg-system (répétable)
  --no-disable       n'en désactive aucune (ignore aussi le fichier de config)
  --stop             arrête la session Waydroid quand l'appli se ferme
  --list             liste les applis installées dans Android (pour choisir quoi désactiver)
  --list-bg          liste les applis Android qui tournent en ce moment (arrière-plan compris)
  --restore          réactive les applis désactivées par une session interrompue
  -h, --help         cette aide

Fichier de config des applis à désactiver (un paquet par ligne) :
  ~/.config/waydroid-focus/disable.list
Les applis désactivées sont toujours réactivées à la fermeture, sur Ctrl+C, ou au
prochain lancement si la session avait été interrompue brutalement.
EOF
}

say() { printf '%s\n' "$*"; }
warn() { printf 'waydroid-focus : %s\n' "$*" >&2; }
die() {
  warn "$*"
  exit 1
}

# ---------------------------------------------------------------- arguments
while (($#)); do
  case $1 in
  -h | --help)
    usage
    exit 0
    ;;
  -n | --dry-run) DRY=1 ;;
  --freeze) FREEZE=1 ;;
  --no-freeze) FREEZE=0 ;;
  --no-android) ANDROID=0 ;;
  --stop) STOP=1 ;;
  --no-disable) NODISABLE=1 ;;
  --list) MODE=list ;;
  --list-bg) MODE=listbg ;;
  --bg) BG=1 ;;
  --bg-system)
    BG=1
    BGSYS=1
    ;;
  --keep-app)
    shift
    [[ ${1:-} =~ ^[A-Za-z0-9_.]+$ ]] || die "--keep-app attend un nom de paquet (voir --list)"
    KEEPAPP+=("$1")
    ;;
  --restore) MODE=restore ;;
  --disable)
    shift
    [[ ${1:-} =~ ^[A-Za-z0-9_.]+$ ]] || die "--disable attend un nom de paquet (voir --list)"
    DISABLE+=("$1")
    ;;
  --gpu-max)
    shift
    [[ ${1:-} =~ ^[0-9]+$ ]] || die "--gpu-max attend une valeur en MHz"
    GPUMAX=$1
    ;;
  --size)
    shift
    [[ ${1:-} =~ ^[0-9]+x[0-9]+$ ]] || die "--size attend LARGEURxHAUTEUR (ex. 720x1560)"
    SIZE=$1
    ;;
  --keep)
    shift
    [[ -n ${1:-} ]] || die "--keep attend une regex"
    KEEP_EXTRA+=("$1")
    ;;
  -*) die "option inconnue : $1 (voir --help)" ;;
  *)
    [[ -z $PKG ]] || die "un seul paquet à la fois"
    PKG=$1
    ;;
  esac
  shift
done

if [[ $MODE == run && -z $PKG ]]; then
  usage
  exit 2
fi
case $PKG in
guitartuna | guitar-tuna) PKG=com.ovelin.guitartuna ;;
esac

command -v waydroid >/dev/null || ((DRY)) || die "waydroid introuvable"

# ------------------------------------------------------- accès au shell Android
WSH_MODE=""
wsh_detect() {
  local out
  out=$(sudo waydroid shell -- sh -c 'echo ok' 2>/dev/null </dev/null)
  if [[ $out == *ok* ]]; then
    WSH_MODE=dashdash
    return 0
  fi
  out=$(sudo waydroid shell sh -c 'echo ok' 2>/dev/null </dev/null)
  if [[ $out == *ok* ]]; then
    WSH_MODE=plain
    return 0
  fi
  return 1
}

# wsh "commande android" : exécute dans le conteneur
wsh() {
  if ((DRY)); then
    say "  [dry-run] (android) $1" >&2
    return 0
  fi
  wsh_ro "$1"
}

# wsh_ro "commande android" : idem, pour une commande qui ne modifie rien.
# Exécutée même en dry-run, afin que --dry-run affiche la vraie liste de paquets.
wsh_ro() {
  case $WSH_MODE in
  dashdash) sudo waydroid shell -- sh -c "$1" </dev/null ;;
  plain) sudo waydroid shell sh -c "$1" </dev/null ;;
  *) return 1 ;;
  esac
}

# ------------------------------------------------------------------ état
ANIMS=(window_animation_scale transition_animation_scale animator_duration_scale)
declare -A SAVED_ANIM=()
FROZEN=()
GPU_DIR=""
GPU_MAX_SAVED=""
SIZE_CHANGED=0
ANDROID_DONE=0
RESTORED=0

# ------------------------------------------------------------- gel de l'hôte
ANC=" "
compute_ancestors() {
  local p=$$
  ANC=" "
  while [[ -n $p && $p -gt 1 ]]; do
    ANC+="$p "
    p=$(sed 's/.*) //' "/proc/$p/stat" 2>/dev/null | awk '{print $2}')
  done
}

freeze_others() {
  compute_ancestors
  local d pid comm x skip
  for d in "$ROOT"/proc/[0-9]*; do
    pid=${d##*/}
    [[ $ANC == *" $pid "* ]] && continue
    [[ -O $d ]] || continue
    grep -qs '^drm-driver:[[:space:]]*msm' "$d"/fdinfo/* 2>/dev/null || continue
    read -r comm <"$d/comm" 2>/dev/null || continue
    [[ $comm =~ $KEEP_RE ]] && continue
    skip=0
    for x in "${KEEP_EXTRA[@]}"; do
      [[ $comm =~ $x ]] && skip=1 && break
    done
    ((skip)) && continue
    if ((DRY)); then
      say "  [dry-run] gèlerait $comm ($pid)"
    elif kill -STOP "$pid" 2>/dev/null; then
      FROZEN+=("$pid:$comm")
    fi
  done
  if ((DRY)); then
    return
  fi
  if ((${#FROZEN[@]})); then
    say "Gelés pendant l'appli : ${FROZEN[*]//:/ }"
  else
    say "Aucun autre processus GPU à geler."
  fi
}

thaw_others() {
  local e
  for e in "${FROZEN[@]}"; do
    kill -CONT "${e%%:*}" 2>/dev/null
  done
  if ((${#FROZEN[@]})); then
    say "Relancés : ${FROZEN[*]//:/ }"
  fi
  FROZEN=()
}

# ------------------------------------------------------------ côté Android
android_apply() {
  local k v
  if [[ -z $WSH_MODE ]] && ! wsh_detect; then
    if ((DRY)); then
      warn "shell Waydroid inaccessible : la liste des applis ne peut pas être vérifiée"
    else
      warn "shell Waydroid inaccessible : réglages Android ignorés"
      return
    fi
  fi
  for k in "${ANIMS[@]}"; do
    v=$(wsh "settings get global $k" | tr -d '\r')
    SAVED_ANIM[$k]=${v:-null}
    wsh "settings put global $k 0"
  done
  enable_apps # reste éventuel d'une session interrompue
  ((NODISABLE)) || disable_apps
  wsh "am kill-all"
  if [[ -n $SIZE ]]; then
    wsh "wm size $SIZE"
    SIZE_CHANGED=1
  fi
  ANDROID_DONE=1
  say "Android : animations coupées, applis en cache arrêtées${SIZE:+, résolution $SIZE}."
}

android_restore() {
  ((ANDROID_DONE)) || return 0
  local k v
  for k in "${ANIMS[@]}"; do
    v=${SAVED_ANIM[$k]:-null}
    [[ $v == null ]] && v=1.0
    wsh "settings put global $k $v"
  done
  ((SIZE_CHANGED)) && wsh "wm size reset"
  ANDROID_DONE=0
}

# ------------------------------------------------- applis Android à désactiver
# pkg_list [option] : noms de paquets, un par ligne (sans "package:" ni \r)
pkg_list() {
  wsh_ro "pm list packages $*" 2>/dev/null | tr -d '\r' | sed -n 's/^package://p'
}

# Paquets à protéger en plus : le clavier et le lanceur réellement en service.
DYN_PROTECT=" "
dynamic_protect() {
  local out pkg
  out=$(wsh_ro "settings get secure default_input_method" 2>/dev/null | tr -d '\r')
  pkg=${out%%/*}
  [[ $pkg =~ ^[A-Za-z0-9_.]+$ ]] && DYN_PROTECT+="$pkg "
  out=$(wsh_ro "cmd package resolve-activity --brief -a android.intent.action.MAIN -c android.intent.category.HOME" 2>/dev/null | tr -d '\r' | tail -1)
  pkg=${out%%/*}
  [[ $pkg =~ ^[A-Za-z0-9_.]+$ ]] && DYN_PROTECT+="$pkg "
  [[ $DYN_PROTECT == "  " ]] || say "Protégés d'office (clavier, accueil) :$DYN_PROTECT"
}

# Réactive tout ce que nous avons désactivé (suivi dans STATE_FILE).
enable_apps() {
  [[ -s $STATE_FILE ]] || return 0
  if [[ -z $WSH_MODE ]] && ! ((DRY)); then
    wsh_detect || {
      warn "shell Waydroid inaccessible : applis non réactivées (voir $STATE_FILE, puis --restore)"
      return 0
    }
  fi
  local pkg n=0
  while read -r pkg; do
    [[ -n $pkg ]] || continue
    wsh "pm enable $pkg" >/dev/null && n=$((n + 1))
  done <"$STATE_FILE"
  ((DRY)) || rm -f "$STATE_FILE"
  say "Applis Android réactivées : $n."
}

# Applis Android qui ont un processus en ce moment (arrière-plan compris).
list_bg() {
  local installed third name seen=" "
  local t=() s=()
  installed=$'\n'$(pkg_list)$'\n'
  third=$'\n'$(pkg_list -3)$'\n'
  while read -r name; do
    name=${name%%:*}
    [[ $installed == *$'\n'"$name"$'\n'* ]] || continue
    [[ $seen == *" $name "* ]] && continue
    seen+="$name "
    if [[ $third == *$'\n'"$name"$'\n'* ]]; then t+=("$name"); else s+=("$name"); fi
  done < <(wsh "ps -A" | tr -d '\r' | awk 'NR>1 {print $NF}')
  say "Applis tierces en cours d'exécution :"
  if ((${#t[@]})); then printf '  %s\n' "${t[@]}" | sort; else say "  (aucune)"; fi
  say ""
  say "Applis système en cours d'exécution :"
  if ((${#s[@]})); then printf '  %s\n' "${s[@]}" | sort; else say "  (aucune)"; fi
  say ""
  say "--bg désactive les applis tierces, --bg-system y ajoute les applis système non"
  say "essentielles (essaie d'abord avec -n). Liste figée : $CONF_FILE"
}

disable_apps() {
  local want=() pkg line k
  declare -A explicit=() # demandé nommément : on explique pourquoi on refuse
  [[ -r $CONF_FILE ]] && while IFS= read -r line; do
    line=${line%%#*}
    line=${line//[[:space:]]/}
    [[ -n $line ]] && want+=("$line") && explicit[$line]=1
  done <"$CONF_FILE"
  for pkg in "${DISABLE[@]}"; do
    want+=("$pkg")
    explicit[$pkg]=1
  done
  if ((BG)); then
    dynamic_protect
    while IFS= read -r pkg; do
      [[ -n $pkg ]] && want+=("$pkg")
    done < <(pkg_list -3)
    if ((BGSYS)); then
      while IFS= read -r pkg; do
        [[ -n $pkg ]] && want+=("$pkg")
      done < <(pkg_list -s)
    fi
  fi
  ((${#want[@]})) || return 0

  local installed disabled ok=()
  if [[ -n $WSH_MODE ]]; then
    installed=$'\n'$(pkg_list)$'\n'
    disabled=$'\n'$(pkg_list -d)$'\n'
  else
    installed=""
    disabled=""
  fi
  declare -A seen=()
  for pkg in "${want[@]}"; do
    [[ -n ${seen[$pkg]:-} ]] && continue
    seen[$pkg]=1
    for k in "${KEEPAPP[@]}"; do
      [[ $pkg == "$k" ]] && continue 2
    done
    [[ $DYN_PROTECT == *" $pkg "* ]] && continue
    if [[ $pkg == "$PKG" ]]; then
      [[ -n ${explicit[$pkg]:-} ]] && warn "$pkg est l'appli lancée : ignorée"
      continue
    fi
    if [[ $pkg =~ $PROTECT_RE ]]; then
      # avec --bg/--bg-system la liste vient de pm : on ne commente que l'explicite
      [[ -n ${explicit[$pkg]:-} ]] && warn "$pkg est protégée : ignorée"
      continue
    fi
    if [[ -n $installed ]]; then
      [[ $installed == *$'\n'"$pkg"$'\n'* ]] || {
        [[ -n ${explicit[$pkg]:-} ]] && warn "$pkg n'est pas installée : ignorée"
        continue
      }
      [[ $disabled == *$'\n'"$pkg"$'\n'* ]] && continue # déjà désactivée avant nous
    fi
    ok+=("$pkg")
  done
  ((${#ok[@]})) || {
    say "Aucune appli Android à désactiver."
    return 0
  }

  if ((DRY)); then
    say "  [dry-run] ${#ok[@]} appli(s) seraient désactivées : ${ok[*]}"
    return 0
  fi
  mkdir -p "$(dirname "$STATE_FILE")"
  local out done=() failed=()
  for pkg in "${ok[@]}"; do
    # on note d'abord, pour pouvoir réactiver même si on est tué entre-temps
    echo "$pkg" >>"$STATE_FILE"
    out=$(wsh "am force-stop $pkg; pm disable-user --user 0 $pkg" 2>&1)
    if [[ $out == *"new state: disabled"* || $out == *disabled-user* || -z $out ]]; then
      done+=("$pkg")
    else
      failed+=("$pkg") # Android refuse : paquet non désactivable, rien n'a changé
      grep -vxF "$pkg" "$STATE_FILE" >"$STATE_FILE.n" 2>/dev/null &&
        mv "$STATE_FILE.n" "$STATE_FILE"
    fi
  done
  say "Applis Android désactivées (${#done[@]}) : ${done[*]:-aucune}"
  ((${#failed[@]})) && say "Non désactivables, laissées telles quelles : ${failed[*]}"
  return 0
}

# -------------------------------------------------------------------- GPU
gpu_dir() {
  local d
  for d in "$ROOT"/sys/class/devfreq/*; do
    case ${d##*/} in
    *gpu* | *adreno*)
      echo "$d"
      return
      ;;
    esac
  done
}

gpu_cap() {
  GPU_DIR=$(gpu_dir)
  if [[ -z $GPU_DIR ]]; then
    warn "devfreq GPU introuvable : --gpu-max ignoré"
    return
  fi
  GPU_MAX_SAVED=$(<"$GPU_DIR/max_freq")
  local hz=$((GPUMAX * 1000000))
  if ((DRY)); then
    say "  [dry-run] max_freq GPU : $GPU_MAX_SAVED -> $hz"
    GPU_MAX_SAVED=""
    return
  fi
  if echo "$hz" | sudo tee "$GPU_DIR/max_freq" >/dev/null; then
    say "GPU plafonné à ${GPUMAX} MHz."
  else
    warn "impossible d'écrire max_freq"
    GPU_MAX_SAVED=""
  fi
}

gpu_restore() {
  [[ -n $GPU_MAX_SAVED ]] || return 0
  echo "$GPU_MAX_SAVED" | sudo tee "$GPU_DIR/max_freq" >/dev/null
  say "Fréquence max du GPU restaurée."
  GPU_MAX_SAVED=""
}

# --------------------------------------------------------------- restauration
restore() {
  ((RESTORED)) && return
  RESTORED=1
  thaw_others
  enable_apps
  android_restore
  gpu_restore
  if ((STOP)) && ! ((DRY)); then
    say "Arrêt de la session Waydroid."
    waydroid session stop >/dev/null 2>&1
  fi
}
trap restore EXIT
trap 'exit 130' INT TERM

# ------------------------------------------------------------------- session
session_running() {
  waydroid status 2>/dev/null | grep -q 'Session:.*RUNNING'
}

if ((DRY)); then
  # en simulation on ne modifie rien, mais on lit la liste des paquets : sudo requis
  sudo -v || warn "sans sudo, la liste des applis ne pourra pas être lue"
else
  sudo -v || die "sudo est nécessaire (shell Waydroid, fréquence GPU)"
  if ! session_running; then
    say "Démarrage de la session Waydroid…"
    nohup waydroid session start >/dev/null 2>&1 &
    for _ in $(seq 1 30); do
      sleep 1
      session_running && break
    done
    session_running || die "la session Waydroid ne démarre pas"
  fi
fi
((DRY)) && wsh_detect >/dev/null 2>&1

# ------------------------------------------------------- --list et --restore
if [[ $MODE != run ]]; then
  RESTORED=1 # rien à restaurer à la sortie dans ces modes
  ((DRY)) && die "--dry-run ne s'utilise pas avec --list ni --restore"
  wsh_detect || die "shell Waydroid inaccessible"
  if [[ $MODE == listbg ]]; then
    list_bg
    exit 0
  fi
  if [[ $MODE == list ]]; then
    say "Applis tierces (installées par toi) :"
    pkg_list -3 | sort | sed 's/^/  /'
    say ""
    say "Applis système :"
    pkg_list -s | sort | sed 's/^/  /'
    say ""
    say "Pour en désactiver pendant une appli : --disable PAQUET, ou un paquet par ligne dans"
    say "$CONF_FILE"
  else
    if [[ -s $STATE_FILE ]]; then
      enable_apps
    else
      say "Rien à réactiver."
    fi
  fi
  exit 0
fi

# ------------------------------------------------------------------ application
((FREEZE)) && freeze_others
((ANDROID)) && android_apply
[[ -n $GPUMAX ]] && gpu_cap

say "Lancement de $PKG…"
if ((DRY)); then
  say "  [dry-run] waydroid app launch $PKG"
  say "  [dry-run] attente de la fermeture de l'appli, puis restauration"
  exit 0
fi
waydroid app launch "$PKG" || die "échec du lancement de $PKG"

# --------------------------------------------------------------------- attente
app_running() {
  local out
  out=$(wsh "pidof $PKG" 2>/dev/null | tr -d '\r')
  [[ $out =~ ^[0-9]+ ]]
}

if [[ -z $WSH_MODE ]]; then
  # pas de shell Android : on ne peut pas suivre l'appli, on attend la touche Entrée
  say "Appuie sur Entrée quand tu as fini avec l'appli."
  read -r _
  exit 0
fi

started=0
for _ in $(seq 1 20); do
  if app_running; then
    started=1
    break
  fi
  sleep 2
done
((started)) || die "l'appli ne s'est pas lancée (restauration)"

say "Appli en cours. Ferme-la ou fais Ctrl+C pour tout restaurer."
miss=0
while ((miss < 2)); do
  sleep 3
  if app_running; then miss=0; else miss=$((miss + 1)); fi
done
say "Appli fermée."
